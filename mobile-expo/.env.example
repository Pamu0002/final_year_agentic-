# Use your PC's IPv4 address, never localhost, when opening the app on an iPhone.
EXPO_PUBLIC_API_URL=http://172.20.10.4:3000
EXPO_PUBLIC_AI_SERVICE_URL=http://172.20.10.4:8000

# Firebase client / Web config only. These values are public by design.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Stripe publishable sandbox key only: pk_test_... Never place sk_test_... here.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google OAuth client IDs from Google Cloud Console
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
