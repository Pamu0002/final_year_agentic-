# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=agent_platform
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/agent_platform

# Redis
REDIS_URL=redis://localhost:6379

# Neo4j
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_me
NEO4J_DATABASE=neo4j

# Firebase (service account JSON fields)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# Gemini / Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/YOUR_USER/path/to/finalyear_agentic_bot/credentials/gcp-key.json
VERTEX_PROJECT_ID=your_gcp_project
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
USE_FAKE_EMBEDDINGS=true

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
RESTAURANT_CONFIRMATION_MINUTES=30

# Nodemailer (Gmail SMTP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
EMAIL_FROM=Pamudi Restaurant <your_email@gmail.com>

# App
NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=3001
JWT_SECRET=your_jwt_secret
SEED_VERBOSE=true
