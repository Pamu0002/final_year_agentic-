# PostgreSQL
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/agent_platform

# Redis is currently optional, but retained for future caching/checkpointing
REDIS_URL=redis://localhost:6379

# Neo4j (local or Aura)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_me
NEO4J_DATABASE=neo4j

# Vertex AI / Gemini
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/YOUR_USER/path/to/finalyear_agentic_bot/credentials/gcp-key.json
VERTEX_PROJECT_ID=your-google-cloud-project
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
USE_FAKE_EMBEDDINGS=true

# Backend callback URL
BACKEND_URL=http://localhost:3000

# Firebase Admin SDK (used by Firestore tools)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com

# Optional recommendation context
OPENWEATHER_API_KEY=
